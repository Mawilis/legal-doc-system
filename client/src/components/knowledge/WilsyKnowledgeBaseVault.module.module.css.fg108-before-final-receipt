/* eslint-disable */
.vaultShell {
  height: 100vh;
  min-height: 0;
  display: grid;
  grid-template-rows: auto auto auto auto minmax(0, 1fr);
  gap: 12px;
  padding: 20px 22px 18px;
  overflow: hidden;
  color: #f7fbff;
  background:
    radial-gradient(circle at top left, rgba(80, 162, 255, 0.18), transparent 34%),
    linear-gradient(135deg, #08111f 0%, #101928 52%, #07101c 100%);
}

.vaultTopbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 430px);
  gap: 16px;
  align-items: stretch;
  min-height: 0;
}

.eyebrow {
  margin: 0 0 6px;
  color: #8fb6dc;
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.vaultTopbar h1 {
  margin: 0;
  font-size: clamp(2rem, 3.4vw, 3.7rem);
  line-height: 0.94;
  letter-spacing: -0.06em;
}

.lede {
  max-width: 980px;
  margin: 10px 0 0;
  color: #b8c7d8;
  font-size: 0.95rem;
  line-height: 1.45;
}

.authorityPill {
  display: grid;
  gap: 8px;
  align-content: center;
  padding: 14px 16px;
  border: 1px solid rgba(146, 184, 222, 0.2);
  border-radius: 22px;
  background: rgba(10, 20, 34, 0.78);
}

.authorityPill span,
.workspaceStats span,
.navigatorHeader span,
.categoryRail span,
.documentRow span,
.documentRowActive span,
.workbenchHeader span,
.workbenchStatus span,
.summaryTable span,
.sectionHeader span,
.taskRow span,
.evidenceControlRow span,
.actionReceipt span {
  color: #8fb6dc;
  font-size: 0.68rem;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.authorityPill strong {
  color: #ffffff;
  font-size: 1rem;
}

.authorityPill small,
.actionReceipt small {
  color: rgba(210, 228, 248, 0.76);
  line-height: 1.4;
}

.commandStrip {
  display: flex;
  gap: 12px;
  align-items: center;
  min-height: 44px;
}

.searchBox {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding: 0 14px;
  border: 1px solid rgba(146, 184, 222, 0.2);
  border-radius: 16px;
  background: rgba(8, 17, 31, 0.72);
}

.searchBox input {
  width: 100%;
  color: #f7fbff;
  border: 0;
  outline: 0;
  background: transparent;
  font: inherit;
}

.searchBox input::placeholder {
  color: rgba(184, 199, 216, 0.62);
}

.refreshButton,
.taskBar button,
.evidenceControlRow button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 38px;
  border: 1px solid rgba(146, 184, 222, 0.22);
  border-radius: 999px;
  color: #f7fbff;
  background: rgba(24, 42, 64, 0.86);
  font-size: 0.8rem;
  font-weight: 900;
  cursor: pointer;
}

.refreshButton {
  padding: 0 16px;
}

.refreshButton:hover,
.taskBar button:hover,
.evidenceControlRow button:hover {
  border-color: rgba(177, 214, 255, 0.48);
  background: rgba(39, 69, 104, 0.9);
}

.taskBar button:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.workspaceStats {
  display: grid;
  grid-template-columns: 120px minmax(0, 1fr) 180px 160px;
  gap: 10px;
  min-height: 66px;
}

.workspaceStats div {
  padding: 11px 12px;
  border: 1px solid rgba(146, 184, 222, 0.16);
  border-radius: 16px;
  background: rgba(8, 17, 31, 0.62);
  overflow: hidden;
}

.workspaceStats strong {
  display: block;
  margin-top: 7px;
  overflow: hidden;
  color: #ffffff;
  font-size: 0.93rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.actionReceipt {
  display: grid;
  grid-template-columns: 180px minmax(0, 1fr);
  gap: 8px 14px;
  align-items: center;
  min-height: 48px;
  padding: 10px 12px;
  border: 1px solid rgba(74, 222, 128, 0.24);
  border-radius: 16px;
  background: rgba(10, 40, 34, 0.62);
}

.actionReceipt strong {
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.actionReceipt small {
  grid-column: 2;
}

.emptyState,
.errorState {
  padding: 14px;
  border: 1px solid rgba(146, 184, 222, 0.16);
  border-radius: 16px;
  background: rgba(8, 17, 31, 0.7);
  color: #dbe8f7;
}

.errorState {
  border-color: rgba(255, 120, 120, 0.32);
}

.errorState strong,
.errorState span {
  display: block;
}

.errorState span {
  margin-top: 6px;
  color: #ffc5c5;
}

.vaultWorkspace {
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(300px, 380px) minmax(0, 1fr);
  gap: 12px;
  overflow: hidden;
}

.knowledgeBaseViewDock {
  grid-column: 1 / -1;
  grid-row: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.documentNavigator,
.documentWorkbench {
  min-height: 0;
  border: 1px solid rgba(146, 184, 222, 0.16);
  border-radius: 20px;
  background: rgba(9, 18, 31, 0.72);
  overflow: hidden;
}

.documentNavigator {
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
}

.navigatorHeader {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 13px 14px;
  border-bottom: 1px solid rgba(146, 184, 222, 0.12);
}

.navigatorHeader strong {
  color: #ffffff;
}

.categoryRail {
  display: flex;
  gap: 8px;
  padding: 10px;
  overflow-x: auto;
  border-bottom: 1px solid rgba(146, 184, 222, 0.12);
}

.categoryButton,
.categoryButtonActive {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 34px;
  padding: 0 10px;
  border: 1px solid rgba(146, 184, 222, 0.18);
  border-radius: 999px;
  color: #dcecff;
  background: rgba(15, 28, 45, 0.8);
  cursor: pointer;
}

.categoryButtonActive {
  border-color: rgba(255, 215, 94, 0.56);
  background: rgba(44, 34, 10, 0.72);
}

.categoryButton strong,
.categoryButtonActive strong {
  color: #ffffff;
  font-size: 0.76rem;
}

.documentList {
  min-height: 0;
  display: grid;
  align-content: start;
  gap: 8px;
  padding: 10px;
  overflow-y: auto;
  padding-bottom: 110px;
}

.documentRow,
.documentRowActive {
  display: grid;
  gap: 5px;
  width: 100%;
  padding: 11px 12px;
  border: 1px solid rgba(146, 184, 222, 0.14);
  border-radius: 15px;
  color: #ffffff;
  background: rgba(6, 13, 23, 0.58);
  text-align: left;
  cursor: pointer;
}

.documentRowActive {
  border-color: rgba(255, 215, 94, 0.52);
  box-shadow: inset 0 0 0 1px rgba(255, 215, 94, 0.13);
}

.documentRow strong,
.documentRowActive strong {
  color: #ffffff;
  font-size: 0.9rem;
  line-height: 1.28;
}

.documentRow small,
.documentRowActive small {
  color: rgba(210, 228, 248, 0.72);
  line-height: 1.35;
}

.documentWorkbench {
  display: grid;
  align-content: start;
  gap: 12px;
  padding: 14px;
  overflow-y: auto;
  padding-bottom: 120px;
}

.workbenchHeader {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 150px;
  gap: 12px;
  align-items: start;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(146, 184, 222, 0.12);
}

.workbenchHeader h2 {
  margin: 6px 0 0;
  color: #ffffff;
  font-size: clamp(1.25rem, 2vw, 2rem);
  line-height: 1.06;
}

.workbenchHeader p {
  max-width: 840px;
  margin: 8px 0 0;
  color: rgba(210, 228, 248, 0.75);
  line-height: 1.45;
}

.workbenchStatus {
  display: grid;
  gap: 6px;
  justify-items: end;
}

.workbenchStatus strong {
  color: #ffffff;
}

.taskBar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.taskBar button,
.evidenceControlRow button {
  padding: 0 12px;
}

.summaryTable {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border: 1px solid rgba(146, 184, 222, 0.13);
  border-radius: 16px;
  overflow: hidden;
}

.summaryTable div {
  min-height: 76px;
  padding: 11px;
  border-right: 1px solid rgba(146, 184, 222, 0.11);
  border-bottom: 1px solid rgba(146, 184, 222, 0.11);
  background: rgba(6, 13, 23, 0.48);
}

.summaryTable strong {
  display: block;
  margin-top: 7px;
  color: #ffffff;
  font-size: 0.9rem;
  line-height: 1.28;
  overflow-wrap: anywhere;
}

.taskQueue,
.evidencePanel {
  display: grid;
  gap: 8px;
}

.sectionHeader {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: baseline;
}

.sectionHeader strong {
  color: #ffffff;
  font-size: 0.9rem;
}

.taskRow,
.evidenceControlRow {
  display: grid;
  grid-template-columns: minmax(180px, 0.45fr) minmax(0, 1fr) auto;
  gap: 10px;
  align-items: center;
  padding: 10px 11px;
  border: 1px solid rgba(146, 184, 222, 0.13);
  border-radius: 14px;
  background: rgba(6, 13, 23, 0.5);
}

.taskRow small {
  color: rgba(210, 228, 248, 0.72);
}

.evidenceControlRow strong {
  color: #ffffff;
  overflow-wrap: anywhere;
  font-size: 0.86rem;
}

@media (max-width: 1180px) {
  .vaultShell {
    height: auto;
    min-height: 100vh;
    overflow: visible;
  }

  .vaultTopbar,
  .vaultWorkspace,
  .workbenchHeader {
    grid-template-columns: 1fr;
  }

  .documentNavigator,
  .documentWorkbench {
    max-height: none;
  }
}

@media (max-width: 860px) {
  .vaultShell {
    padding: 16px;
  }

  .commandStrip {
    flex-direction: column;
    align-items: stretch;
  }

  .workspaceStats,
  .summaryTable {
    grid-template-columns: 1fr;
  }

  .taskRow,
  .evidenceControlRow,
  .actionReceipt {
    grid-template-columns: 1fr;
  }

  .actionReceipt small {
    grid-column: 1;
  }

  .workbenchStatus {
    justify-items: start;
  }
}

.searchButton {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  border: 1px solid rgba(111, 214, 255, 0.34);
  border-radius: 999px;
  padding: 0.72rem 1rem;
  background: rgba(77, 166, 255, 0.12);
  color: #d9f3ff;
  font-weight: 800;
  letter-spacing: 0.02em;
  cursor: pointer;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.searchButton:hover,
.searchButton:focus-visible {
  border-color: rgba(111, 214, 255, 0.72);
  background: rgba(77, 166, 255, 0.2);
  outline: none;
}

.searchStatus {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: center;
  border: 1px solid rgba(149, 180, 255, 0.16);
  border-radius: 18px;
  padding: 0.8rem 1rem;
  background: rgba(7, 16, 29, 0.76);
  color: rgba(231, 241, 255, 0.86);
}

.searchStatus strong {
  color: #ffffff;
  font-size: 0.94rem;
}

.searchStatus span {
  color: rgba(186, 203, 226, 0.82);
  font-size: 0.84rem;
}

.selectedDocumentTitle {
  margin: 0.25rem 0 0;
  color: rgba(226, 238, 255, 0.9);
  font-size: clamp(1.05rem, 2vw, 1.45rem);
  font-weight: 800;
  line-height: 1.2;
}

.naturalOperatorSurface {
  margin: 1rem 0 0.85rem;
  padding: 0;
  border: 0;
  background: transparent;
  color: rgba(221, 234, 255, 0.9);
}

.naturalOperatorSurface p {
  max-width: 1100px;
  margin: 0;
  color: rgba(213, 228, 249, 0.9);
  font-size: clamp(0.98rem, 1.35vw, 1.12rem);
  line-height: 1.72;
}

.naturalOperatorSurface strong {
  color: #ffffff;
  font-weight: 900;
}

.naturalOperatorSurface span {
  color: rgba(255, 255, 255, 0.96);
  font-weight: 900;
}

.inlineOperatorActions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-top: 0.85rem;
}

.inlineOperatorActions button {
  border: 0;
  border-bottom: 1px solid rgba(112, 215, 255, 0.72);
  border-radius: 0;
  padding: 0.1rem 0;
  background: transparent;
  color: #dff6ff;
  font: inherit;
  font-weight: 850;
  cursor: pointer;
}

.inlineOperatorActions button:hover,
.inlineOperatorActions button:focus-visible {
  color: #ffffff;
  border-bottom-color: #ffffff;
  outline: none;
}

.inlineOperatorActions button:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.vaultShell {
  padding-bottom: 7rem;
}

.documentWorkbench {
  min-height: 0;
  padding-bottom: 5.5rem;
}

.taskBar {
  flex-wrap: wrap;
}

@media (max-width: 1100px) {
  .searchStatus {
    align-items: flex-start;
    flex-direction: column;
  }

  .inlineOperatorActions {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* FG108O4B — Knowledge Base Operating Room investor-grade surface */
.knowledgeCommandSpine {
  display: grid;
  grid-template-columns: minmax(210px, 0.85fr) repeat(3, minmax(180px, 1fr));
  gap: 12px;
  align-items: stretch;
  margin: 14px 0 16px;
}

.originReturnCommand,
.knowledgeSpineCell {
  position: relative;
  min-height: 84px;
  border: 1px solid rgba(137, 194, 255, 0.24);
  background:
    radial-gradient(circle at top left, rgba(106, 79, 255, 0.16), transparent 38%),
    linear-gradient(135deg, rgba(8, 15, 29, 0.94), rgba(10, 23, 42, 0.86));
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.24);
  border-radius: 20px;
  padding: 16px 17px;
  color: rgba(244, 248, 255, 0.94);
  overflow: hidden;
}

.originReturnCommand {
  cursor: pointer;
  text-align: left;
}

.originReturnCommand::before,
.knowledgeSpineCell::before {
  content: '';
  position: absolute;
  inset: 0;
  border-top: 1px solid rgba(232, 210, 133, 0.36);
  pointer-events: none;
}

.originReturnCommand span,
.knowledgeSpineCell span,
.knowledgeSourceBrief span {
  display: block;
  color: rgba(163, 199, 255, 0.92);
  font-size: 0.68rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-weight: 900;
  margin-bottom: 8px;
}

.originReturnCommand strong,
.knowledgeSpineCell strong {
  display: block;
  color: rgba(255, 255, 255, 0.98);
  font-size: 1rem;
  line-height: 1.22;
  margin-bottom: 6px;
}

.originReturnCommand small,
.knowledgeSpineCell small {
  display: block;
  color: rgba(181, 195, 218, 0.76);
  font-size: 0.78rem;
  line-height: 1.35;
}

.originReturnCommand:hover,
.originReturnCommand:focus-visible {
  border-color: rgba(231, 209, 126, 0.74);
  box-shadow: 0 20px 60px rgba(99, 72, 255, 0.24), 0 0 0 1px rgba(231, 209, 126, 0.32);
  outline: none;
  transform: translateY(-1px);
}

.knowledgeSourceBrief {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 18px 0 14px;
}

.knowledgeSourceBrief div {
  min-height: 148px;
  border: 1px solid rgba(122, 168, 235, 0.18);
  border-radius: 18px;
  padding: 16px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.018)),
    rgba(3, 10, 22, 0.72);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.knowledgeSourceBrief strong {
  display: block;
  color: rgba(255, 255, 255, 0.96);
  font-size: 1rem;
  line-height: 1.22;
  margin-bottom: 9px;
}

.knowledgeSourceBrief p {
  margin: 0;
  color: rgba(192, 205, 225, 0.82);
  font-size: 0.88rem;
  line-height: 1.45;
}

.vaultTopbar h1 {
  letter-spacing: -0.055em;
}

@media (max-width: 1180px) {
  .knowledgeCommandSpine,
  .knowledgeSourceBrief {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .knowledgeCommandSpine,
  .knowledgeSourceBrief {
    grid-template-columns: 1fr;
  }
}

/* FG108O4C — Compact hover intelligence dock.
   Default state stays tiny. Detailed context appears only on hover/focus. */
.knowledgeCommandSpine {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  margin: 9px 0 10px;
}

.originReturnCommand,
.knowledgeSpineCell {
  min-height: 46px;
  height: 46px;
  border-radius: 14px;
  padding: 8px 10px;
  overflow: hidden;
  transition:
    transform 140ms ease,
    box-shadow 140ms ease,
    border-color 140ms ease,
    min-height 140ms ease;
}

.originReturnCommand span,
.knowledgeSpineCell span {
  font-size: 0.56rem;
  letter-spacing: 0.2em;
  margin-bottom: 3px;
  white-space: nowrap;
}

.originReturnCommand strong,
.knowledgeSpineCell strong {
  font-size: 0.82rem;
  line-height: 1.05;
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.originReturnCommand small,
.knowledgeSpineCell small {
  display: none;
}

.originReturnCommand:hover,
.originReturnCommand:focus-visible,
.knowledgeSpineCell:hover,
.knowledgeSpineCell:focus-visible {
  position: fixed;
  top: 50%;
  left: 50%;
  width: min(720px, 86vw);
  min-height: 210px;
  height: auto;
  max-height: 72vh;
  z-index: 9000;
  transform: translate(-50%, -50%);
  padding: 26px 30px;
  border-radius: 26px;
  overflow: auto;
  outline: none;
  box-shadow:
    0 36px 120px rgba(0, 0, 0, 0.62),
    0 0 0 1px rgba(232, 210, 133, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.originReturnCommand:hover small,
.originReturnCommand:focus-visible small,
.knowledgeSpineCell:hover small,
.knowledgeSpineCell:focus-visible small {
  display: block;
  margin-top: 14px;
  font-size: 0.92rem;
  line-height: 1.55;
  white-space: normal;
}

.originReturnCommand:hover strong,
.originReturnCommand:focus-visible strong,
.knowledgeSpineCell:hover strong,
.knowledgeSpineCell:focus-visible strong {
  font-size: 1.55rem;
  line-height: 1.15;
  white-space: normal;
}

.knowledgeSourceBrief {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 8px 0 10px;
}

.knowledgeSourceBrief div {
  position: relative;
  flex: 0 1 176px;
  min-height: 42px;
  height: 42px;
  border-radius: 999px;
  padding: 7px 12px;
  cursor: default;
  overflow: hidden;
  transition:
    transform 140ms ease,
    box-shadow 140ms ease,
    border-color 140ms ease,
    border-radius 140ms ease;
}

.knowledgeSourceBrief div span {
  font-size: 0.55rem;
  letter-spacing: 0.18em;
  margin: 0 0 2px;
  white-space: nowrap;
}

.knowledgeSourceBrief div strong {
  font-size: 0.78rem;
  line-height: 1.05;
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.knowledgeSourceBrief div p {
  display: none;
}

.knowledgeSourceBrief div:hover,
.knowledgeSourceBrief div:focus-visible {
  position: fixed;
  top: 50%;
  left: 50%;
  width: min(760px, 88vw);
  min-height: 260px;
  height: auto;
  max-height: 72vh;
  z-index: 9100;
  transform: translate(-50%, -50%);
  border-radius: 28px;
  padding: 28px 32px;
  overflow: auto;
  outline: none;
  box-shadow:
    0 40px 130px rgba(0, 0, 0, 0.64),
    0 0 0 1px rgba(232, 210, 133, 0.34),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.knowledgeSourceBrief div:hover span,
.knowledgeSourceBrief div:focus-visible span {
  font-size: 0.72rem;
  margin-bottom: 12px;
}

.knowledgeSourceBrief div:hover strong,
.knowledgeSourceBrief div:focus-visible strong {
  display: block;
  font-size: 1.6rem;
  line-height: 1.15;
  white-space: normal;
  margin-bottom: 14px;
}

.knowledgeSourceBrief div:hover p,
.knowledgeSourceBrief div:focus-visible p {
  display: block;
  font-size: 1rem;
  line-height: 1.58;
}

.inlineOperatorActions,
.taskBar,
.evidenceControlRow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7px;
  margin: 8px 0;
  padding: 6px 0;
  max-height: 52px;
}

.inlineOperatorActions button,
.taskBar button,
.evidenceControlRow button {
  min-height: 34px;
  border-radius: 999px;
  padding: 7px 11px;
  font-size: 0.78rem;
  line-height: 1;
}

.workbenchStatus {
  grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
  gap: 7px;
  margin: 8px 0;
}

.workbenchStatus > div {
  min-height: 40px;
  border-radius: 14px;
  padding: 8px 10px;
  overflow: hidden;
}

.workbenchStatus > div span {
  font-size: 0.55rem;
  letter-spacing: 0.17em;
  margin-bottom: 3px;
}

.workbenchStatus > div strong {
  font-size: 0.82rem;
  line-height: 1.08;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.workbenchStatus > div small {
  display: none;
}

.documentWorkbench {
  min-height: 0;
