{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wilsy.invalid/schemas/industry-pack.v1.schema.json",
  "title": "WILSY Industry Pack Reference Schema",
  "description": "Validates declarative industry-pack metadata only. It grants no IAM permission, entitlement, tenant scope, or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "pack_id",
    "pack_version",
    "display_name",
    "description",
    "status",
    "capability_dependencies",
    "workflow_templates",
    "suggested_capacities",
    "configuration_schema_refs",
    "authority_constraints",
    "notes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_id": {
      "const": "wilsy.industry-pack"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "pack_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "status": {
      "enum": [
        "REFERENCE_TEMPLATE_NOT_ENTITLED",
        "PUBLISHED",
        "DEPRECATED"
      ]
    },
    "capability_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "minimum_version"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "minimum_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      },
      "uniqueItems": true
    },
    "workflow_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_id",
          "version",
          "owner_capability",
          "stages"
        ],
        "properties": {
          "workflow_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "owner_capability": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage_id",
                "required_evidence"
              ],
              "properties": {
                "stage_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "required_evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    },
    "suggested_capacities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "uniqueItems": true
    },
    "configuration_schema_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_grant_permissions",
        "may_activate_entitlements",
        "may_define_principal_capacity",
        "may_override_tenant_scope",
        "may_execute_arbitrary_code",
        "may_replace_capability_source_of_truth"
      ],
      "properties": {
        "may_grant_permissions": {
          "const": false
        },
        "may_activate_entitlements": {
          "const": false
        },
        "may_define_principal_capacity": {
          "const": false
        },
        "may_override_tenant_scope": {
          "const": false
        },
        "may_execute_arbitrary_code": {
          "const": false
        },
        "may_replace_capability_source_of_truth": {
          "const": false
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
