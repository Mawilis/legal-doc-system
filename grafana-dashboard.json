{
  "dashboard": {
    "id": null,
    "uid": "wilsy-sovereign-master",
    "title": "WILSY OS - Runtime Observability",
    "description": "Production dashboard backed exclusively by metrics exposed by the live Wilsy API at /metrics. Financial, audit, and compliance claims are intentionally omitted until their corresponding exporters exist.",
    "timezone": "browser",
    "refresh": "15s",
    "theme": "dark",
    "schemaVersion": 36,
    "version": 2,
    "time": { "from": "now-6h", "to": "now" },
    "panels": [
      {
        "type": "stat",
        "title": "Invoices Created",
        "description": "Cumulative invoices created by the running Wilsy API process.",
        "id": 1,
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
        "targets": [{ "refId": "A", "expr": "sum(wilsy_invoices_created_total)", "instant": true, "legendFormat": "Invoices" }],
        "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "palette-classic" } }, "overrides": [] },
        "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
      },
      {
        "type": "stat",
        "title": "Redis Dependency Health",
        "description": "1 means the Redis health gauge is available; 0 means the dependency is unavailable or degraded.",
        "id": 2,
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
        "targets": [{ "refId": "A", "expr": "max(wilsy_redis_health_status)", "instant": true, "legendFormat": "Redis" }],
        "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "mappings": [{ "type": "value", "options": { "0": { "text": "DEGRADED", "color": "red", "index": 0 }, "1": { "text": "HEALTHY", "color": "green", "index": 1 } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
        "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }
      },
      {
        "type": "stat",
        "title": "Logical CPU Cores",
        "description": "Number of CPU cores observed by the Wilsy process exporter.",
        "id": 3,
        "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 },
        "targets": [{ "refId": "A", "expr": "count(wilsy_system_cpu_usage)", "instant": true, "legendFormat": "Cores" }],
        "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "palette-classic" } }, "overrides": [] },
        "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
      },
      {
        "type": "stat",
        "title": "Process Uptime",
        "description": "Uptime reported by the Wilsy process exporter.",
        "id": 4,
        "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 },
        "targets": [{ "refId": "A", "expr": "wilsy_system_memory_bytes{type=\"uptime\"}", "instant": true, "legendFormat": "Uptime" }],
        "fieldConfig": { "defaults": { "unit": "s", "decimals": 0, "color": { "mode": "palette-classic" } }, "overrides": [] },
        "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
      },
      {
        "type": "timeseries",
        "title": "CPU Utilization by Core",
        "description": "Per-core CPU utilization sampled by the Wilsy runtime exporter.",
        "id": 5,
        "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
        "targets": [{ "refId": "A", "expr": "wilsy_system_cpu_usage", "legendFormat": "Core {{core}}" }],
        "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "color": { "mode": "palette-classic" } }, "overrides": [] },
        "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
      },
      {
        "type": "timeseries",
        "title": "Runtime Memory",
        "description": "Heap and resident memory exposed by the Wilsy runtime exporter.",
        "id": 6,
        "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
        "targets": [{ "refId": "A", "expr": "wilsy_system_memory_bytes{type=~\"heapUsed|heapTotal|rss\"}", "legendFormat": "{{type}}" }],
        "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "color": { "mode": "palette-classic" } }, "overrides": [] },
        "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
      },
      {
        "type": "timeseries",
        "title": "Node.js Event-Loop Lag",
        "description": "The p50, p90, and p99 event-loop lag from Prometheus default Node.js metrics.",
        "id": 7,
        "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
        "targets": [
          { "refId": "A", "expr": "wilsynodejs_eventloop_lag_p50_seconds * 1000", "legendFormat": "p50" },
          { "refId": "B", "expr": "wilsynodejs_eventloop_lag_p90_seconds * 1000", "legendFormat": "p90" },
          { "refId": "C", "expr": "wilsynodejs_eventloop_lag_p99_seconds * 1000", "legendFormat": "p99" }
        ],
        "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "color": { "mode": "palette-classic" } }, "overrides": [] },
        "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
      },
      {
        "type": "table",
        "title": "Live Runtime Capacity Inventory",
        "description": "Current values emitted by the Wilsy runtime exporter; this is operational telemetry, not an audit ledger.",
        "id": 8,
        "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
        "targets": [{ "refId": "A", "expr": "wilsy_system_memory_bytes", "format": "table", "instant": true }],
        "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "align": "auto", "cellOptions": { "type": "auto" } }, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
        "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
        "transformations": [{ "id": "labelsToFields", "options": {} }]
      }
    ]
  },
  "overwrite": true
}
