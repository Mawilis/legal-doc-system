  "__comment": "════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════",

  "dashboard": {
    "title": "Wilsy OS – Verification Sync",
    "tags": ["wilsy-os", "verification", "reconciliation", "sync"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Total Processed (per min)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(verification_sync_processed_total[$__rate_interval]))",
            "format": "time_series",
            "legendFormat": "processed",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
        "description": "Average number of invoices reconciled per minute by the sync job."
      },
      {
        "id": 2,
        "title": "Errors (per min)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(verification_sync_errors_total[$__rate_interval]))",
            "format": "time_series",
            "legendFormat": "errors",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.1 },
                { "color": "red", "value": 1 }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
        "description": "Average number of errors encountered per minute during reconciliation."
      },
      {
        "id": 3,
        "title": "Last Run Timestamp",
        "type": "stat",
        "targets": [
          {
            "expr": "verification_sync_last_run_timestamp",
            "format": "time_series",
            "legendFormat": "last_run",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "dateTimeAsLocal",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
        "description": "Timestamp of the most recent sync job execution."
      },
      {
        "id": 4,
        "title": "Resolution Breakdown",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(verification_sync_processed_total) by (resolution)",
            "format": "time_series",
            "legendFormat": "{{resolution}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 4 },
        "description": "Distribution of reconciliation resolutions: ServerCanonicalAccepted, DualTimestampPersisted, LocalOnly."
      },
      {
        "id": 5,
        "title": "Processing Duration (ms)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(verification_sync_duration_ms_bucket[$__rate_interval])) by (le))",
            "format": "time_series",
            "legendFormat": "p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(verification_sync_duration_ms_bucket[$__rate_interval])) by (le))",
            "format": "time_series",
            "legendFormat": "p50",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        },
        "gridPos": { "h": 8, "w": 18, "x": 6, "y": 4 },
        "description": "Latency percentiles of sync job runs over time."
      },
      {
        "id": 6,
        "title": "Success Rate (%)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(verification_sync_processed_total[$__rate_interval])) / (sum(rate(verification_sync_processed_total[$__rate_interval])) + sum(rate(verification_sync_errors_total[$__rate_interval]))) * 100",
            "format": "time_series",
            "legendFormat": "success_rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 90 },
                { "color": "green", "value": 99 }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
        "description": "Percentage of successful reconciliations (processed / total attempts)."
      }
    ],
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": {},
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    },
    "links": [],
    "refresh": "30s",
    "editable": true,
    "graphTooltip": 1,
    "id": null,
    "uid": "verification-sync-dashboard",
    "version": 1
  }
}
